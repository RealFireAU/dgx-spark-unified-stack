# Copy to .env and fill in real values. .env is gitignored.

# Paths — LLM_ROOT_PATH/gguf and LLM_ROOT_PATH/safetensors are the two
# consolidated model pools every engine reads from.
LLM_ROOT_PATH=/path/to/your/models
REPO_CONFIG_PATH=/path/to/this/repo

# Network
CF_API_TOKEN=

# LiteLLM
LITELLM_MASTER_KEY=
DATABASE_URL=postgresql://litellm_admin:changeme@litellm-db:5432/litellm
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=changeme
# Host-facing URL (through Caddy) — used by scripts/benchmark_memory_usage.py
LITELLM_BASE_URL=https://litellm.example.com

# llama-swap (shared with LiteLLM's per-model litellm_params)
LLAMA_SWAP_API_KEY=changeme
LLAMA_SWAP_API_BASE=http://llama-swap:8080/v1
# Host-facing URL (through Caddy) — used by scripts/benchmark_memory_usage.py
LLAMA_SWAP_BASE_URL=https://llama-swap.example.com

# Public image tags (no local Dockerfile for these two)
LLAMA_SWAP_IMAGE_TAG=v250-cpu-b10524-non-root
LITELLM_IMAGE_TAG=v1.97.0

# Host's docker group GID, from `getent group docker` — lets llama-swap's
# non-root user reach /var/run/docker.sock
DOCKER_GID=988

# Postgres
POSTGRES_DB=litellm
POSTGRES_USER=litellm_admin
POSTGRES_PASSWORD=changeme
